// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// SAAS — CABINETS & ABONNEMENTS
// ============================================

enum SaasPlan {
  STARTER
  PRO
  ENTERPRISE
}

enum SaasStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// Un cabinet = un tenant SaaS. Chaque cabinet regroupe ses utilisateurs,
/// ses dossiers clients et son abonnement Wave/mobile-money.
model Cabinet {
  id                  String     @id @default(auto()) @map("_id") @db.ObjectId
  slug                String     @unique
  nom                 String
  plan                SaasPlan   @default(STARTER)
  statut              SaasStatus @default(TRIAL)
  trialExpiresAt      DateTime?
  pays                String     @default("SN")
  phone               String?
  /// Référence de paiement Wave (client_reference) pour rapprochement webhook
  waveClientRef       String?    @unique
  /// Date d'activation du dernier paiement Wave confirmé
  lastPaidAt          DateTime?
  /// Période couverte par le dernier paiement (en mois)
  lastPaidMonths      Int?
  maxDossiers         Int        @default(25)
  maxCollaborateurs   Int        @default(2)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  users               User[]

  @@map("cabinets")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

enum UserRole {
  ADMIN
  EXPERT
  COLLABORATOR
  CLIENT
  ASSISTANT
}

model User {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  email       String    @unique
  password    String
  firstName   String
  lastName    String
  role        UserRole  @default(COLLABORATOR)
  phone       String?
  avatar      String?
  // Cout horaire interne (charge, hors marge), utilise pour le calcul du
  // boni/mali de mission. Absent tant que le cabinet ne l'a pas parametre :
  // le cout interne d'une mission reste alors indetermine plutot que nul.
  costRate    Float?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Lien tenant SaaS (optionnel en Phase 1, requis en Phase 2)
  cabinetId   String?   @db.ObjectId
  cabinet     Cabinet?  @relation(fields: [cabinetId], references: [id])

  // Relations
  assignedMissions     Mission[]            @relation("AssignedTo")
  createdMissions      Mission[]            @relation("CreatedBy")
  timeEntries          TimeEntry[]
  balancesImportees    BalanceImportee[]    @relation("BalancesImportees")
  meetings             Meeting[]
  documents            Document[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  createdProspects     Prospect[]
  proposals            Proposal[]
  trainingEnrollments  TrainingEnrollment[]
  certificates         Certificate[]
  quizAttempts         QuizAttempt[]
  expenses             Expense[]            @relation("ExpenseOwner")
  expensesApproved     Expense[]            @relation("ExpenseApprover")
  missionOrders        MissionOrder[]
  judicialCases        JudicialCase[]
  engagementLetters    EngagementLetter[]
  correspondences      Correspondence[]
  procedures           Procedure[]
  resourceAllocations  ResourceAllocation[]
  apiKeys              ApiKey[]
  webhooks             Webhook[]
  workspacesCreated    Workspace[]          @relation("WorkspaceCreator")
  workspaceMemberships WorkspaceMember[]    @relation("WorkspaceMemberships")
  workspaceActivities  WorkspaceActivity[]  @relation("WorkspaceActivityAuthor")
  forumPosts           ForumPost[]
  forumComments        ForumComment[]

  @@map("users")
}

// ============================================
// CLIENTS (CRM)
// ============================================

enum ClientType {
  ENTREPRISE
  PARTICULIER
  ASSOCIATION
}

enum FiscalRegime {
  REEL_NORMAL
  REEL_SIMPLIFIE
  CME
  MICRO_ENTREPRISE
}

model Client {
  id   String     @id @default(auto()) @map("_id") @db.ObjectId
  type ClientType @default(ENTREPRISE)

  // Identification
  companyName String?
  firstName   String?
  lastName    String?
  email       String  @unique
  phone       String

  // Identifiants OHADA
  rccm  String? // Registre Commerce
  ninea String? // Sénégal
  ifu   String? // Bénin/CI
  nif   String? // Cameroun

  // Fiscal
  fiscalRegime FiscalRegime @default(REEL_NORMAL)
  sector       String? // Secteur d'activité
  country      String       @default("CI") // CI, SN, CM, etc.

  // Paramètres de paie propres à l'employeur (moteurs src/lib/payroll/engines) :
  // classe de risque accident du travail (SN : 0.01/0.03/0.05 ; CI : 0.02 à 0.05)
  // et cotisation maladie IPM (SN, parts salariale/patronale). Null = défaut du moteur.
  paieAccidentRate  Float?
  paieIpmSalarial   Float?
  paieIpmPatronal   Float?

  // Adresse
  address    String?
  city       String?
  postalCode String?

  // Haute Expertise - Governance & Health (Real Data)
  agStatus           String? // late, valid, expiring
  mandatStatus       String?
  depotComptesStatus String?
  kycStatus          String? // valid, invalid
  healthScore        Float? // 0-100
  rating             String? // AAA, AA, B, etc.

  // Onboarding digital (Stripe Identity + prélèvement SEPA) : identifiants
  // reels des sessions Stripe, pas des statuts inventes. kycStatus (ci-dessus)
  // est mis a jour a partir du resultat reel de la Stripe Identity
  // VerificationSession une fois traitee.
  stripeIdentitySessionId String?
  stripeCustomerId        String?
  sepaMandateStatus       String? // pending, active, failed

  // Status
  subjectToTva Boolean @default(false) // Paramétrage flexible de la TVA
  isActive     Boolean @default(true)

  // Portail PMI
  // Pas de contrainte @unique en base : de nombreux clients existants ont portalToken=null,
  // et MongoDB rejette un index unique classique sur des valeurs null dupliquées. L'unicité
  // effective est garantie côté application par une génération cryptographiquement aléatoire
  // (32 octets, voir src/app/api/clients/route.ts) — collision négligeable.
  portalToken     String? // Token unique pour l'URL du portail client
  portalEnabled   Boolean   @default(false)
  portalCreatedAt DateTime?

  balancesImportees BalanceImportee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  missions              Mission[]
  invoices              Invoice[]
  documents             Document[]
  meetings              Meeting[]
  timeEntries           TimeEntry[]
  declarations          TaxDeclaration[]
  financialData         FinancialData[]
  mobileMoneyTx         MobileMoneyTransaction[]
  creditScores          CreditScore[]
  informelBusiness      InformelBusiness?
  tpeJournals           TpeJournal[]
  employees             Employee[]
  payrollPeriods        PayrollPeriod[]
  fixedAssets           FixedAsset[]
  products              Product[]
  proposals             Proposal[]
  consolidationEntities ConsolidationEntity[]
  judicialCases         JudicialCase[]
  engagementLetters     EngagementLetter[]
  personalAssets        PersonalAsset[]
  correspondences       Correspondence[]
  workspaces            Workspace[]
  fraudAlerts           FraudAlert[]
  fiscalRisks           FiscalRisk[]
  clientRequests        ClientRequest[]
  workPapers            WorkPaper[]

  @@map("clients")
}

// ============================================
// MISSIONS & TASKS
// ============================================

enum MissionStatus {
  DRAFT
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
  CANCELLED
}

enum MissionType {
  AUDIT
  CONSEIL
  TENUE_COMPTABLE
  DECLARATION_FISCALE
  PAIE
  EXPERTISE_JUDICIAIRE
  AUTRE
}

model Mission {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  type        MissionType
  status      MissionStatus @default(DRAFT)

  // Dates
  startDate DateTime
  endDate   DateTime?
  deadline  DateTime?

  // Financial
  estimatedHours Float?
  hourlyRate     Float?
  fixedPrice     Float?

  // Relations
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  assignedToId String? @db.ObjectId
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])

  createdById String @db.ObjectId
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  tasks               Task[]
  timeEntries         TimeEntry[]
  documents           Document[]
  auditSections       AuditSection[]
  expenses            Expense[]
  missionOrders       MissionOrder[]
  engagementLetters   EngagementLetter[]
  resourceAllocations ResourceAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("missions")
}

model Task {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  status      MissionStatus @default(DRAFT)
  priority    Int           @default(1) // 1-5

  dueDate     DateTime?
  completedAt DateTime?

  missionId String  @db.ObjectId
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  resourceAllocations ResourceAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

// ============================================
// TIME TRACKING
// ============================================

enum TimeEntryCategory {
  PRODUCTION
  CONSEIL
  AUDIT
  DEPLACEMENT
  REUNION
  AUTRE
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  INVOICED
}

model TimeEntry {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  date        DateTime
  duration    Float // En heures (ex: 2.5)
  category    TimeEntryCategory @default(PRODUCTION)
  status      TimeEntryStatus   @default(DRAFT)
  description String?

  // Relations
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id])

  missionId String?  @db.ObjectId
  mission   Mission? @relation(fields: [missionId], references: [id])

  invoiceId String?  @db.ObjectId
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("time_entries")
}

// ============================================
// INVOICING & BILLING
// ============================================

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// Balance générale importée (CSV / Excel) pour un dossier et une période de
// clôture (YYYY-MM). Quand elle existe, le moteur SYSCOHADA la préfère au
// journal d'écritures pour produire bilan, résultat, TFT et liasse.
model BalanceImportee {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  periode String // YYYY-MM : mois de clôture de la balance
  fichier String?

  // CompteBalance[] : { numero, intitule, debit, credit }
  lignes      Json
  nbLignes    Int
  totalDebit  Float
  totalCredit Float
  equilibree  Boolean

  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  importedById String @db.ObjectId
  importedBy   User   @relation("BalancesImportees", fields: [importedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, periode])
  @@map("balances_importees")
}

model Invoice {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber String @unique

  issueDate DateTime  @default(now())
  dueDate   DateTime
  paidDate  DateTime?

  status InvoiceStatus @default(DRAFT)

  // Amounts (en FCFA)
  subtotal  Float
  taxRate   Float @default(18) // TVA 18% OHADA
  taxAmount Float
  total     Float

  notes String?

  // Détail des prestations facturées : [{ designation, quantity, unitPrice }].
  // Absent des factures antérieures au 11/09/2026 (seuls les totaux existaient).
  lines Json?

  // Relations
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id])

  timeEntries  TimeEntry[]
  transactions BankTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

// ============================================
// DOCUMENTS & OCR
// ============================================

enum DocumentType {
  FACTURE
  RELEVE_BANCAIRE
  CONTRAT
  RAPPORT
  DECLARATION
  PIECE_IDENTITE
  AUTRE
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  ERROR
}

model Document {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  fileUrl      String
  // Clé du fichier dans le stockage durable (GridFS) ; null pour les pièces
  // antérieures au 11/09/2026, restées sur le disque du serveur.
  storageKey   String?

  type   DocumentType   @default(AUTRE)
  status DocumentStatus @default(UPLOADED)

  // OCR Data
  ocrData        Json? // Données extraites par OCR
  ocrProcessedAt DateTime?

  // Relations
  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id])

  missionId String?  @db.ObjectId
  mission   Mission? @relation(fields: [missionId], references: [id])

  uploadedById String @db.ObjectId
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
}

// ============================================
// TAX DECLARATIONS
// ============================================

enum DeclarationType {
  TVA
  IS
  IRPP
  COTISATION_SOCIALE
  AUTRE
}

enum DeclarationStatus {
  DRAFT
  PENDING
  SUBMITTED
  VALIDATED
  REJECTED
}

model TaxDeclaration {
  id     String            @id @default(auto()) @map("_id") @db.ObjectId
  type   DeclarationType
  status DeclarationStatus @default(DRAFT)

  period        String // Ex: "2024-01" pour Janvier 2024
  dueDate       DateTime
  submittedDate DateTime?

  amount    Float?
  reference String? // Numéro de quittance

  // Relations
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tax_declarations")
}

// ============================================
// MEETINGS & AGENDA
// ============================================

enum MeetingType {
  VIRTUELLE
  PRESENTIEL
}

enum MeetingStatus {
  PLANIFIE
  TERMINE
  ANNULE
}

model Meeting {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?

  type   MeetingType   @default(VIRTUELLE)
  status MeetingStatus @default(PLANIFIE)

  startTime  DateTime
  endTime    DateTime
  location   String?
  meetingUrl String? // Lien visio

  notes           String?
  reportGenerated Boolean @default(false)

  // Relations
  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id])

  organizerId String @db.ObjectId
  organizer   User   @relation(fields: [organizerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meetings")
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

model Notification {
  id      String           @id @default(auto()) @map("_id") @db.ObjectId
  type    NotificationType @default(INFO)
  title   String
  message String

  isRead Boolean   @default(false)
  readAt DateTime?

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  action   String // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity   String // Client, Mission, Invoice, etc.
  entityId String?
  details  String? // Complementary info

  oldValue Json?
  newValue Json?

  ipAddress String?
  userAgent String?

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ============================================
// HAUTE EXPERTISE - REAL DATA MODELS
// ============================================

model Communication {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  type     String // email, whatsapp, portal, teams
  sender   String
  avatar   String? // Initials
  subject  String?
  preview  String?
  content  String
  date     DateTime @default(now())
  clientId String?  @db.ObjectId
  read     Boolean  @default(false)
  tags     String[]

  @@map("communications")
}

model NewsBrief {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  type      String // FISCAL, LEGAL, URGENT
  content   String
  summary   String?
  source    String?
  relevance Int      @default(5) // 1-10
  date      DateTime @default(now())
  isRead    Boolean  @default(false)

  @@map("news_briefs")
}

// ============================================
// FINANCIAL DATA (Balances & SIG)
// ============================================

model FinancialData {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  year   Int // Ex: 2023, 2024
  period String? // Ex: "ANNUAL", "H1", "Q1"

  // Key Indicators (Calculated or Imported)
  ca         Float @default(0)
  ebitda     Float @default(0) // EBE
  netResult  Float @default(0)
  totalBilan Float @default(0)
  equity     Float @default(0) // Fonds propres
  netCash    Float @default(0)
  bfr        Float @default(0)

  // Status
  isProjected Boolean @default(false)

  // Relations
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("financial_data")
}

// ============================================
// FINTECH & MOBILE MONEY
// ============================================

model MobileMoneyTransaction {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  operator    String // Wave, Orange Money, MTN MoMo
  reference   String  @unique
  senderName  String?
  senderPhone String
  amount      Float
  type        String // IN, OUT
  status      String  @default("PENDING") // PENDING, RECONCILED

  transactionDate DateTime
  reconciledAt    DateTime?

  // Relations
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mobile_money_transactions")
}

model CreditScore {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  score      Int // 0 - 1000
  factors    Json // Details of the score components
  isEligible Boolean @default(false)

  evaluatedAt DateTime @default(now())

  // Relations
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("credit_scores")
}

// ============================================
// ACCOMPAGNEMENT INFORMEL
// ============================================

model InformelBusiness {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  businessName String
  activityType String
  phone        String

  // Workflow Status
  stepIdCompleted Boolean @default(false)
  stepRccmDone    Boolean @default(false)
  isFormalized    Boolean @default(false)

  // Relations
  clientId String @unique @db.ObjectId // Links to the Client once formalized
  client   Client @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("informel_businesses")
}

// ============================================
// MODULE TPE : CAHIER DE CAISSE BPO
// ============================================

model TpeJournal {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  periode      String // Ex: "JUIN-2026"
  businessName String // Nom du commerçant/TPE

  // Raw line from client
  date    String
  libelle String
  entree  Float  @default(0)
  sortie  Float  @default(0)

  // Nouveaux champs BPO (Informel)
  source          String  @default("WHATSAPP") // WHATSAPP, MOBILE_MONEY
  rawContent      String? // Le texte brut ou la transcription vocale
  confidenceScore Float   @default(0) // Score de confiance de l'IA (0 - 1)

  // OHADA accounting (generated by engine)
  debitCompte    String
  debitIntitule  String
  creditCompte   String
  creditIntitule String
  montant        Float

  // Status
  exportedAt DateTime? // Date de validation
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXPORTED

  // Relations
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())

  @@map("tpe_journals")
}

// ------------------------------------------
// NOUVEAUX MODULES (PHASE 2)
// ------------------------------------------

// --- 1. BANQUE & LETTRAGE IA ---
model BankTransaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime
  description String
  amount      Float
  type        String // "DEBIT" ou "CREDIT"
  status      String   @default("PENDING") // "PENDING", "RECONCILED", "IGNORED"

  // Relation avec une facture si rapprochée
  invoiceId String?  @db.ObjectId
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  fraudAlerts FraudAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bank_transactions")
}

// --- 2. MACHINE LEARNING & AUTO-APPRENTISSAGE ---
model AccountingRuleMapping {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  keyword      String // Ex: "sonatel", "shell"
  debitCompte  String
  creditCompte String
  clientId     String?  @db.ObjectId // Si null, la règle est globale au cabinet
  usageCount   Int      @default(1)
  createdAt    DateTime @default(now())

  @@map("accounting_rule_mappings")
}

// --- 3. MODULE PAIE & SOCIAL (PHASE 3) ---
model Employee {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  firstName  String
  lastName   String
  phone      String?
  email      String?
  position   String?
  baseSalary Float

  // Paramètres Multi-Pays (ex: Sénégal)
  maritalStatus      String? @default("CELIBATAIRE")
  childrenCount      Int     @default(0)
  isCadre            Boolean @default(false)
  transportAllowance Float   @default(0)
  // Conjoints sans revenu : chacun ajoute une part TRIMF (Sénégal) et, pour
  // une femme mariée, ouvre la demi-part du conjoint (CGI art. 174).
  conjointsSansRevenu Int    @default(0)
  // "M" ou "F" : la femme mariée est imposée comme célibataire au Sénégal.
  sexe               String?
  // Avantages en nature mensuels (logement, véhicule…), valeur imposable.
  avantagesNature    Float   @default(0)

  // Règlement du salaire (ordre de paiement) : VIREMENT, WAVE, ORANGE_MONEY,
  // FREE_MONEY, ESPECES, CHEQUE.
  modePaiement      String?
  banque            String?
  iban              String? // IBAN ou RIB
  numeroMobileMoney String?

  // Relations
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

model PayrollPeriod {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  periodName String // Ex: "Juin 2026"
  status     String @default("DRAFT") // DRAFT, VALIDATED, PAID

  // Paiement constaté (saisie manuelle : aucun virement n'est émis par l'application)
  paidAt      DateTime?
  paymentMode String? // VIREMENT, WAVE, ORANGE_MONEY, FREE_MONEY, ESPECES, CHEQUE
  paymentRef  String?

  // Relations
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payroll_periods")
}

model Payslip {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Variables de paie (dictée IA ou saisie manuelle)
  absencesDays  Int   @default(0)
  overtimeHours Float @default(0)
  bonuses       Float @default(0)

  // Éléments figés au moment de la validation : le bulletin doit rester
  // imprimable à l'identique même si la fiche du salarié change ensuite.
  baseSalary         Float  @default(0)
  transportAllowance Float  @default(0)
  avantagesNature    Float  @default(0)
  country            String @default("SN")
  // Détail complet des rubriques produit par le moteur (IPRES, TRIMF, ITS…)
  detail             Json?

  // Calculs finaux
  grossSalary Float
  netSalary   Float

  // Détails Multi-Pays (Cotisations et Impôts)
  taxableIncome   Float @default(0)
  taxes           Float @default(0) // IR, TRIMF
  employeeSocials Float @default(0) // IPRES part salariale
  employerSocials Float @default(0) // IPRES part patronale, CSS, CFCE

  status String @default("DRAFT") // DRAFT, VALIDATED, PAID

  // Relations
  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  periodId String        @db.ObjectId
  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payslips")
}

// ============================================
// AUDIT — Immobilisations & Dossier de travail
// ============================================

enum FixedAssetStatus {
  FOUND
  MISSING
  TO_VERIFY
  DISPOSED
}

enum DepreciationMethod {
  LINEAIRE
  DEGRESSIF
  NON_AMORTISSABLE
}

model FixedAsset {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  code          String
  label         String
  category      String
  purchaseDate  DateTime
  value         Float
  location      String?
  status        FixedAssetStatus @default(TO_VERIFY)
  lastAuditDate DateTime?

  // Plan d'amortissement — indispensable pour calculer la valeur nette
  // comptable et la dotation de l'exercice. Ces champs manquaient : l'actif
  // etait suivi pour l'inventaire physique, jamais pour sa depreciation.
  depreciationMethod DepreciationMethod @default(LINEAIRE)
  usefulLifeYears    Int? // Duree d'utilite, en annees
  residualValue      Float              @default(0)
  // Date de mise en service, qui peut differer de la date d'acquisition et
  // constitue le point de depart de l'amortissement.
  serviceDate        DateTime?
  serialNumber       String?
  supplier           String?

  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fixed_assets")
}

// Centre de requetes client (justificatifs, signatures, informations
// manquantes) : demandes reellement adressees a un client, suivies jusqu'a
// leur traitement.
model ClientRequest {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type     String // Justificatif manquant | Signature requise | Information manquante
  details  String
  priorite String // Haute | Moyenne | Basse
  statut   String @default("A_ENVOYER") // A_ENVOYER | ENVOYEE | REPONSE_RECUE | TRAITEE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_requests")
}

// Cahier de travail generique (seuil de signification, matrice des risques,
// programme d'audit, circularisations, sondage...) persiste par client et
// par type d'outil. Le contenu varie selon l'outil ; il est stocke tel quel,
// sans reinterpretation, pour eviter de figer un schema different par outil
// alors que la structure exacte de chaque cahier est encore amenee a evoluer.
model WorkPaper {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type String
  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, type])
  @@map("work_papers")
}

// ── Comptabilite analytique de gestion ──────────────────────────────────────

enum CostCategory {
  MATIERE_PREMIERE
  MAIN_OEUVRE_DIRECTE
  ENERGIE
  AMORTISSEMENT
  CHARGES_INDIRECTES
  AUTRE
}

/**
 * Produit fabrique ou revendu par un client industriel.
 */
model Product {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  reference    String
  name         String
  family       String?
  /**
   * Unite de mesure : sac, tonne, unite, litre...
   */
  unit         String  @default("unite")
  sellingPrice Float   @default(0)
  isActive     Boolean @default(true)

  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  costs   CostComponent[]
  volumes ProductionVolume[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

/**
 * Composante du cout de revient unitaire d'un produit.
 */
model CostComponent {
  id       String       @id @default(auto()) @map("_id") @db.ObjectId
  category CostCategory
  label    String
  /**
   * Cout unitaire, dans la devise du dossier.
   */
  unitCost Float        @default(0)

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cost_components")
}

/**
 * Quantite produite sur une periode donnee.
 */
model ProductionVolume {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  /**
   * Periode au format AAAA-MM.
   */
  periode  String
  quantity Float  @default(0)

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("production_volumes")
}

