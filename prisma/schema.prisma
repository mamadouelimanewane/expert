/// Données ESG d'un client, avec provenance, niveau d'estimation et revue.
/// Chaque sauvegarde est une version immuable de l'exercice : une correction
/// crée une nouvelle version au lieu d'écraser la piste d'audit précédente.
model EsgAssessment {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId             String?  @db.ObjectId // injecté et filtré par la couche tenant Prisma
  clientId              String   @db.ObjectId
  client                Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodYear            Int
  country               String
  version               Int      @default(1)
  dataQuality           String   // MEASURED, ESTIMATED, MIXED
  evidenceNotes         String
  methodologyVersion   String   @default("ESG-ESTIMATE-1")
  emissionFactorVersion String  @default("GENERIC-2.68-0.45-v1")
  input                 Json
  report                Json
  status                String   @default("DRAFT") // DRAFT, REVIEWED
  reviewComment         String?
  createdById           String   @db.ObjectId
  createdBy             User     @relation("EsgAssessmentCreator", fields: [createdById], references: [id])
  reviewedById          String?  @db.ObjectId
  reviewedBy            User?    @relation("EsgAssessmentReviewer", fields: [reviewedById], references: [id])
  reviewedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("esg_assessments")
  @@unique([cabinetId, clientId, periodYear, version])
  @@index([cabinetId, status, periodYear])
}

