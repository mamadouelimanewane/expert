enum CostCategory {
  MATIERE_PREMIERE
  MAIN_OEUVRE_DIRECTE
  ENERGIE
  AMORTISSEMENT
  CHARGES_INDIRECTES
  AUTRE
}

/**
 * Produit fabrique ou revendu par un client industriel.
 */
model Product {
