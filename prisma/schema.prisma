enum EngagementLetterStatus {
  BROUILLON
  ENVOYEE
  SIGNEE
  EXPIREE
}

model EngagementLetter {
  id            String                 @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  reference     String
  scope         String
  fees          Float?
  status        EngagementLetterStatus @default(BROUILLON)
  signedAt      DateTime?
