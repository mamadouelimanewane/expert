// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// SAAS — CABINETS & ABONNEMENTS
// ============================================

enum SaasPlan {
  STARTER
  PRO
  ENTERPRISE
}

enum SaasStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// Un cabinet = un tenant SaaS. Chaque cabinet regroupe ses utilisateurs,
/// ses dossiers clients et son abonnement Wave/mobile-money.
model Cabinet {
  id                  String     @id @default(auto()) @map("_id") @db.ObjectId
  slug                String     @unique
  nom                 String
  plan                SaasPlan   @default(STARTER)
  statut              SaasStatus @default(TRIAL)
  trialExpiresAt      DateTime?
  pays                String     @default("SN")
  phone               String?
  /// Référence de paiement Wave (client_reference) pour rapprochement webhook
  waveClientRef       String?    @unique
  /// Date d'activation du dernier paiement Wave confirmé
  lastPaidAt          DateTime?
  /// Période couverte par le dernier paiement (en mois)
  lastPaidMonths      Int?
  maxDossiers         Int        @default(25)
  maxCollaborateurs   Int        @default(2)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations
  users               User[]

  @@map("cabinets")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

enum UserRole {
  ADMIN
  EXPERT
  COLLABORATOR
  CLIENT
  ASSISTANT
}

model User {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  email       String    @unique
  password    String
  firstName   String
  lastName    String
  role        UserRole  @default(COLLABORATOR)
  phone       String?
  avatar      String?
  // Cout horaire interne (charge, hors marge), utilise pour le calcul du
  // boni/mali de mission. Absent tant que le cabinet ne l'a pas parametre :
  // le cout interne d'une mission reste alors indetermine plutot que nul.
  costRate    Float?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Lien tenant SaaS (optionnel en Phase 1, requis en Phase 2)
  cabinetId   String?   @db.ObjectId
  cabinet     Cabinet?  @relation(fields: [cabinetId], references: [id])

  // Relations
  assignedMissions     Mission[]            @relation("AssignedTo")
  createdMissions      Mission[]            @relation("CreatedBy")
  timeEntries          TimeEntry[]
  balancesImportees    BalanceImportee[]    @relation("BalancesImportees")
  meetings             Meeting[]
  documents            Document[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  createdProspects     Prospect[]
  proposals            Proposal[]
  trainingEnrollments  TrainingEnrollment[]
  certificates         Certificate[]
  quizAttempts         QuizAttempt[]
  expenses             Expense[]            @relation("ExpenseOwner")
  expensesApproved     Expense[]            @relation("ExpenseApprover")
  missionOrders        MissionOrder[]
  judicialCases        JudicialCase[]
  engagementLetters    EngagementLetter[]
  correspondences      Correspondence[]
  procedures           Procedure[]
  resourceAllocations  ResourceAllocation[]
  apiKeys              ApiKey[]
  webhooks             Webhook[]
  workspacesCreated    Workspace[]          @relation("WorkspaceCreator")
  workspaceMemberships WorkspaceMember[]    @relation("WorkspaceMemberships")
  workspaceActivities  WorkspaceActivity[]  @relation("WorkspaceActivityAuthor")
  forumPosts           ForumPost[]
  forumComments        ForumComment[]
  auditReviewCommentsAuthored AuditReviewComment[]      @relation("AuditReviewCommentAuthor")
  auditReviewCommentsAssigned AuditReviewComment[]      @relation("AuditReviewCommentAssignee")
  auditReviewCommentsResolved AuditReviewComment[]      @relation("AuditReviewCommentResolver")
  auditReviewCommentEvents    AuditReviewCommentEvent[] @relation("AuditReviewCommentEventAuthor")
  auditEngagementAssessments  AuditEngagementAssessment[] @relation("AuditEngagementAssessor")
  auditSectionsReviewed      AuditSection[] @relation("AuditSectionReviewer")
  yearEndClosesCreated       YearEndClose[] @relation("YearEndCloseCreator")
  yearEndClosesClosed        YearEndClose[] @relation("YearEndCloseCloser")
  yearEndCloseItemsAssigned  YearEndCloseItem[] @relation("YearEndCloseItemAssignee")
  yearEndCloseItemsCompleted YearEndCloseItem[] @relation("YearEndCloseItemCompleter")
  esgAssessmentsCreated EsgAssessment[] @relation("EsgAssessmentCreator")
  esgAssessmentsReviewed EsgAssessment[] @relation("EsgAssessmentReviewer")
  regulatoryRulesCreated RegulatoryObligationRule[] @relation("RegulatoryRuleCreator")
  regulatoryRulesReviewed RegulatoryObligationRule[] @relation("RegulatoryRuleReviewer")

  @@map("users")
  @@index([cabinetId])
}

// ============================================
// CLIENTS (CRM)
// ============================================

enum ClientType {
  ENTREPRISE
  PARTICULIER
  ASSOCIATION
}

enum FiscalRegime {
  REEL_NORMAL
  REEL_SIMPLIFIE
  CME
  MICRO_ENTREPRISE
}

model Client {
  id   String     @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  type ClientType @default(ENTREPRISE)

  // Identification
  companyName String?
  firstName   String?
  lastName    String?
  email       String
  phone       String

  // Identifiants OHADA
  rccm  String? // Registre Commerce
  ninea String? // Sénégal
  ifu   String? // Bénin/CI
  nif   String? // Cameroun

  // Fiscal
  fiscalRegime FiscalRegime @default(REEL_NORMAL)
  sector       String? // Secteur d'activité
  country      String       @default("CI") // CI, SN, CM, etc.

  // Paramètres de paie propres à l'employeur (moteurs src/lib/payroll/engines) :
  // classe de risque accident du travail (SN : 0.01/0.03/0.05 ; CI : 0.02 à 0.05)
  // et cotisation maladie IPM (SN, parts salariale/patronale). Null = défaut du moteur.
  paieAccidentRate  Float?
  paieIpmSalarial   Float?
  paieIpmPatronal   Float?

  // Adresse
  address    String?
  city       String?
  postalCode String?

  // Haute Expertise - Governance & Health (Real Data)
  agStatus           String? // late, valid, expiring
  mandatStatus       String?
  depotComptesStatus String?
  kycStatus          String? // valid, invalid
  healthScore        Float? // 0-100
  rating             String? // AAA, AA, B, etc.

  // Onboarding digital (Stripe Identity + prélèvement SEPA) : identifiants
  // reels des sessions Stripe, pas des statuts inventes. kycStatus (ci-dessus)
  // est mis a jour a partir du resultat reel de la Stripe Identity
  // VerificationSession une fois traitee.
  stripeIdentitySessionId String?
  stripeCustomerId        String?
  sepaMandateStatus       String? // pending, active, failed

  // Status
  subjectToTva Boolean @default(false) // Paramétrage flexible de la TVA
  // Profil d'assujettissement à compléter et réviser par le cabinet ; les
  // règles nationales versionnées restent à implémenter.
  taxProfile Json?
  isActive     Boolean @default(true)

  // Portail PMI
  // Pas de contrainte @unique en base : de nombreux clients existants ont portalToken=null,
  // et MongoDB rejette un index unique classique sur des valeurs null dupliquées. L'unicité
  // effective est garantie côté application par une génération cryptographiquement aléatoire
  // (32 octets, voir src/app/api/clients/route.ts) — collision négligeable.
  portalToken     String? // Token unique pour l'URL du portail client
  portalEnabled   Boolean   @default(false)
  portalCreatedAt DateTime?

  balancesImportees BalanceImportee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  missions              Mission[]
  invoices              Invoice[]
  documents             Document[]
  meetings              Meeting[]
  timeEntries           TimeEntry[]
  declarations          TaxDeclaration[]
  financialData         FinancialData[]
  mobileMoneyTx         MobileMoneyTransaction[]
  creditScores          CreditScore[]
  informelBusiness      InformelBusiness?
  tpeJournals           TpeJournal[]
  employees             Employee[]
  payrollPeriods        PayrollPeriod[]
  fixedAssets           FixedAsset[]
  products              Product[]
  proposals             Proposal[]
  consolidationEntities ConsolidationEntity[]
  judicialCases         JudicialCase[]
  engagementLetters     EngagementLetter[]
  personalAssets        PersonalAsset[]
  correspondences       Correspondence[]
  workspaces            Workspace[]
  fraudAlerts           FraudAlert[]
  fiscalRisks           FiscalRisk[]
  clientRequests        ClientRequest[]
  workPapers            WorkPaper[]
  yearEndCloses         YearEndClose[]
  esgAssessments        EsgAssessment[]

  @@map("clients")
  @@unique([cabinetId, email])
  @@index([cabinetId])
}

// ============================================
// MISSIONS & TASKS
// ============================================

enum MissionStatus {
  DRAFT
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
  CANCELLED
}

enum MissionType {
  AUDIT
  CONSEIL
  TENUE_COMPTABLE
  DECLARATION_FISCALE
  PAIE
  EXPERTISE_JUDICIAIRE
  AUTRE
}

model Mission {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  title       String
  description String?
  type        MissionType
  status      MissionStatus @default(DRAFT)

  // Dates
  startDate DateTime
  endDate   DateTime?
  deadline  DateTime?

  // Financial
  estimatedHours Float?
  hourlyRate     Float?
  fixedPrice     Float?

  // Relations
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  assignedToId String? @db.ObjectId
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])

  createdById String @db.ObjectId
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  tasks               Task[]
  timeEntries         TimeEntry[]
  documents           Document[]
  auditSections       AuditSection[]
  expenses            Expense[]
  missionOrders       MissionOrder[]
  engagementLetters   EngagementLetter[]
  resourceAllocations ResourceAllocation[]
  auditReviewComments AuditReviewComment[]
  engagementAssessment AuditEngagementAssessment?
  auditSamples        AuditSample[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("missions")
  @@index([cabinetId])
}

model Task {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  title       String
  description String?
  status      MissionStatus @default(DRAFT)
  priority    Int           @default(1) // 1-5

  dueDate     DateTime?
  completedAt DateTime?

  missionId String  @db.ObjectId
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  resourceAllocations ResourceAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
  @@index([cabinetId])
}

// ============================================
// TIME TRACKING
// ============================================

enum TimeEntryCategory {
  PRODUCTION
  CONSEIL
  AUDIT
  DEPLACEMENT
  REUNION
  AUTRE
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  INVOICED
}

model TimeEntry {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner

  date        DateTime
  duration    Float // En heures (ex: 2.5)
  category    TimeEntryCategory @default(PRODUCTION)
  status      TimeEntryStatus   @default(DRAFT)
  description String?

  // Relations
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id])

  missionId String?  @db.ObjectId
  mission   Mission? @relation(fields: [missionId], references: [id])

  invoiceId String?  @db.ObjectId
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("time_entries")
  @@index([cabinetId])
}

// ============================================
// INVOICING & BILLING
// ============================================

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// Balance générale importée (CSV / Excel) pour un dossier et une période de
// clôture (YYYY-MM). Quand elle existe, le moteur SYSCOHADA la préfère au
// journal d'écritures pour produire bilan, résultat, TFT et liasse.
model BalanceImportee {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  periode String // YYYY-MM : mois de clôture de la balance
  fichier String?

  // CompteBalance[] : { numero, intitule, debit, credit }
  lignes      Json
  nbLignes    Int
  totalDebit  Float
  totalCredit Float
  equilibree  Boolean

  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  importedById String @db.ObjectId
  importedBy   User   @relation("BalancesImportees", fields: [importedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, periode])
  @@map("balances_importees")
  @@index([cabinetId])
}

model AccountingPeriodLock {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId   String?  @db.ObjectId // Tenant owner
  clientId    String   @db.ObjectId
  periode     String   // YYYY-MM
  lockedAt    DateTime @default(now())
  lockedById  String   @db.ObjectId
  reason      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, periode])
  @@index([cabinetId])
  @@map("accounting_period_locks")
}

model YearEndClose {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId    String?  @db.ObjectId
  clientId     String   @db.ObjectId
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fiscalYear   Int
  status       String   @default("OPEN") // OPEN, CLOSED
  createdById  String   @db.ObjectId
  createdBy    User     @relation("YearEndCloseCreator", fields: [createdById], references: [id])
  closedById   String?  @db.ObjectId
  closedBy     User?    @relation("YearEndCloseCloser", fields: [closedById], references: [id])
  closedAt     DateTime?
  reopenReason String?
  items        YearEndCloseItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clientId, fiscalYear])
  @@index([cabinetId, status, fiscalYear])
  @@map("year_end_closes")
}

model YearEndCloseItem {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId     String?  @db.ObjectId
  closeId       String   @db.ObjectId
  close         YearEndClose @relation(fields: [closeId], references: [id], onDelete: Cascade)
  key           String
  title         String
  status        String   @default("PENDING") // PENDING, DONE
  evidence      String?
  notes         String?
  assignedToId  String?  @db.ObjectId
  assignedTo    User?    @relation("YearEndCloseItemAssignee", fields: [assignedToId], references: [id])
  completedById String?  @db.ObjectId
  completedBy   User?    @relation("YearEndCloseItemCompleter", fields: [completedById], references: [id])
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([closeId, key])
  @@index([cabinetId, closeId, status])
  @@map("year_end_close_items")
}

model Invoice {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  invoiceNumber String

  issueDate DateTime  @default(now())
  dueDate   DateTime
  paidDate  DateTime?

  status InvoiceStatus @default(DRAFT)

  // Amounts (en FCFA)
  subtotal  Float
  taxRate   Float @default(18) // TVA 18% OHADA
  taxAmount Float
  total     Float

  notes String?

  // Détail des prestations facturées : [{ designation, quantity, unitPrice }].
  // Absent des factures antérieures au 11/09/2026 (seuls les totaux existaient).
  lines Json?

  // Relations
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id])

  timeEntries  TimeEntry[]
  transactions BankTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
  @@unique([cabinetId, invoiceNumber])
  @@index([cabinetId])
}

// ============================================
// DOCUMENTS & OCR
// ============================================

enum DocumentType {
  FACTURE
  RELEVE_BANCAIRE
  CONTRAT
  RAPPORT
  DECLARATION
  PIECE_IDENTITE
  AUTRE
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  ERROR
}

model Document {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  fileUrl      String
  // Clé du fichier dans le stockage durable (GridFS) ; null pour les pièces
  // antérieures au 11/09/2026, restées sur le disque du serveur.
  storageKey   String?

  type   DocumentType   @default(AUTRE)
  status DocumentStatus @default(UPLOADED)

  // OCR Data
  ocrData        Json? // Données extraites par OCR
  ocrProcessedAt DateTime?

  // Relations
  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id])

  missionId String?  @db.ObjectId
  mission   Mission? @relation(fields: [missionId], references: [id])

  uploadedById String @db.ObjectId
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
  @@index([cabinetId])
}

// ============================================
// TAX DECLARATIONS
// ============================================

enum DeclarationType {
  TVA
  IS
  IRPP
  COTISATION_SOCIALE
  AUTRE
}

enum DeclarationStatus {
  DRAFT
  PENDING
  SUBMITTED
  VALIDATED
  REJECTED
}

model TaxDeclaration {
  id     String            @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  type   DeclarationType
  status DeclarationStatus @default(DRAFT)

  period        String // Ex: "2024-01" pour Janvier 2024
  dueDate       DateTime
  submittedDate DateTime?

  amount    Float?
  reference String? // Numéro de quittance
  // Suivi opérationnel du dépôt et du règlement. Ces champs enregistrent les
  // preuves récupérées sur le portail officiel ; ils ne réalisent pas le dépôt.
  obligationCode   String?
  calculationNotes String?
  filingReceipt    String?
  paymentReference String?
  paidAt           DateTime?
  ruleVersion      String?
  regulatoryRuleId String? @db.ObjectId
  regulatoryRule   RegulatoryObligationRule? @relation(fields: [regulatoryRuleId], references: [id], onDelete: SetNull)

  // Relations
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tax_declarations")
  @@index([cabinetId])
}

/// Référentiel réglementaire maintenu par le cabinet. Les règles ne sont
/// utilisables dans les calendriers qu'après revue indépendante et pendant
/// leur période d'effet ; une nouvelle version est créée au lieu d'écraser
/// une règle déjà validée.
model RegulatoryObligationRule {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId           String?  @db.ObjectId
  country             String
  obligationCode      String
  version             Int      @default(1)
  title               String
  description         String
  category            String
  declarationType     DeclarationType
  periodicity         String
  dueDay              Int
  dueMonth            Int?
  clientTypes         ClientType[] @default([])
  fiscalRegimes       FiscalRegime[] @default([])
  sectors             String[] @default([])
  requiredTaxProfileFlags String[] @default([])
  applicabilityNotes  String
  sourceTitle         String
  sourceUrl           String
  sourceArticle       String?
  sourcePublishedAt   DateTime?
  effectiveFrom       DateTime
  effectiveUntil      DateTime?
  status              String   @default("DRAFT") // DRAFT, VERIFIED, RETIRED
  reviewComment       String?
  createdById         String   @db.ObjectId
  createdBy           User     @relation("RegulatoryRuleCreator", fields: [createdById], references: [id])
  reviewedById        String?  @db.ObjectId
  reviewedBy          User?    @relation("RegulatoryRuleReviewer", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  retiredAt           DateTime?
  activation          RegulatoryObligationActivation?
  declarations        TaxDeclaration[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("regulatory_obligation_rules")
  @@unique([cabinetId, country, obligationCode, version])
  @@index([cabinetId, country, status, effectiveFrom])
}

/// Verrou à unicité garantie en base : une seule version validée par pays et
/// code d'obligation peut être active, même si deux réviseurs valident en même
/// temps. Il est supprimé lors du retrait explicite de la règle.
model RegulatoryObligationActivation {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId      String? @db.ObjectId
  country        String
  obligationCode String
  ruleId         String @unique @db.ObjectId
  rule           RegulatoryObligationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@map("regulatory_obligation_activations")
  @@unique([cabinetId, country, obligationCode])
}

// ============================================
// MEETINGS & AGENDA
// ============================================

enum MeetingType {
  VIRTUELLE
  PRESENTIEL
}

enum MeetingStatus {
  PLANIFIE
  TERMINE
  ANNULE
}

model Meeting {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  title       String
  description String?

  type   MeetingType   @default(VIRTUELLE)
  status MeetingStatus @default(PLANIFIE)

  startTime  DateTime
  endTime    DateTime
  location   String?
  meetingUrl String? // Lien visio

  notes           String?
  reportGenerated Boolean @default(false)

  // Relations
  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id])

  organizerId String @db.ObjectId
  organizer   User   @relation(fields: [organizerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meetings")
  @@index([cabinetId])
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

model Notification {
  id      String           @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  type    NotificationType @default(INFO)
  title   String
  message String

  isRead Boolean   @default(false)
  readAt DateTime?

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
  @@index([cabinetId])
}

// ============================================
// AUDIT LOGS
// ============================================

model AuditLog {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  action   String // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity   String // Client, Mission, Invoice, etc.
  entityId String?
  details  String? // Complementary info

  oldValue Json?
  newValue Json?

  ipAddress String?
  userAgent String?

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("audit_logs")
  @@index([cabinetId])
}

// ============================================
// HAUTE EXPERTISE - REAL DATA MODELS
// ============================================

model Communication {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  type     String // email, whatsapp, portal, teams
  sender   String
  avatar   String? // Initials
  subject  String?
  preview  String?
  content  String
  date     DateTime @default(now())
  clientId String?  @db.ObjectId
  read     Boolean  @default(false)
  tags     String[]

  @@map("communications")
