// ============================================
// CORPORATE — Consolidation de Groupe
// ============================================

model ConsolidationGroup {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  entities     ConsolidationEntity[]
  eliminations ConsolidationElimination[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consolidation_groups")
}

model ConsolidationEntity {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  name    String
  rccm    String?
  country String?

  groupId String             @db.ObjectId
  group   ConsolidationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id])

  buyerEliminations  ConsolidationElimination[] @relation("BuyerEntity")
  sellerEliminations ConsolidationElimination[] @relation("SellerEntity")
  balanceLines       ConsolidationBalanceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consolidation_entities")
}

// Ligne de balance comptable importee (CSV) pour une entite du perimetre de
// consolidation. Un import remplace l'ensemble des lignes precedentes de
// l'entite (pas de fusion ligne a ligne : la balance importee fait foi).
model ConsolidationBalanceLine {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  compte  String
  libelle String
  debit   Float  @default(0)
  credit  Float  @default(0)

  entityId String              @db.ObjectId
  entity   ConsolidationEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("consolidation_balance_lines")
}

model ConsolidationElimination {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  type          String
  debitAccount  String
  creditAccount String
  amount        Float

  groupId String             @db.ObjectId
  group   ConsolidationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  buyerEntityId String?              @db.ObjectId
  buyerEntity   ConsolidationEntity? @relation("BuyerEntity", fields: [buyerEntityId], references: [id])

  sellerEntityId String?              @db.ObjectId
  sellerEntity   ConsolidationEntity? @relation("SellerEntity", fields: [sellerEntityId], references: [id])

  createdAt DateTime @default(now())

  @@map("consolidation_eliminations")
}

