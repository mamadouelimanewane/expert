// --- 3. MODULE PAIE & SOCIAL (PHASE 3) ---
model Employee {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  firstName  String
  lastName   String
  phone      String?
  email      String?
  position   String?
  baseSalary Float

  // Paramètres Multi-Pays (ex: Sénégal)
  maritalStatus      String? @default("CELIBATAIRE")
  childrenCount      Int     @default(0)
  isCadre            Boolean @default(false)
  transportAllowance Float   @default(0)
  // Conjoints sans revenu : chacun ajoute une part TRIMF (Sénégal) et, pour
  // une femme mariée, ouvre la demi-part du conjoint (CGI art. 174).
  conjointsSansRevenu Int    @default(0)
  // "M" ou "F" : la femme mariée est imposée comme célibataire au Sénégal.
  sexe               String?
  // Avantages en nature mensuels (logement, véhicule…), valeur imposable.
  avantagesNature    Float   @default(0)

  // Règlement du salaire (ordre de paiement) : VIREMENT, WAVE, ORANGE_MONEY,
  // FREE_MONEY, ESPECES, CHEQUE.
  modePaiement      String?
  banque            String?
  iban              String? // IBAN ou RIB
  numeroMobileMoney String?

  // Relations
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
  @@index([cabinetId])
}

model PayrollPeriod {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  periodName String // Ex: "Juin 2026"
  status     String @default("DRAFT") // DRAFT, VALIDATED, PAID
  ruleVersion String? // Version figée du référentiel légal utilisé pour les bulletins
  ruleInfo    Json?   // Sources, dates d'effet et avertissements au moment de la validation

  // Paiement constaté (saisie manuelle : aucun virement n'est émis par l'application)
  paidAt      DateTime?
  paymentMode String? // VIREMENT, WAVE, ORANGE_MONEY, FREE_MONEY, ESPECES, CHEQUE
  paymentRef  String?

  // Relations
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payroll_periods")
  @@index([cabinetId])
}

model Payslip {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner

  // Variables de paie (dictée IA ou saisie manuelle)
  absencesDays  Int   @default(0)
  overtimeHours Float @default(0)
  bonuses       Float @default(0)

  // Éléments figés au moment de la validation : le bulletin doit rester
  // imprimable à l'identique même si la fiche du salarié change ensuite.
  baseSalary         Float  @default(0)
  transportAllowance Float  @default(0)
  avantagesNature    Float  @default(0)
  country            String @default("SN")
  // Détail complet des rubriques produit par le moteur (IPRES, TRIMF, ITS…)
  detail             Json?

  // Calculs finaux
  grossSalary Float
  netSalary   Float

  // Détails Multi-Pays (Cotisations et Impôts)
  taxableIncome   Float @default(0)
  taxes           Float @default(0) // IR, TRIMF
  employeeSocials Float @default(0) // IPRES part salariale
  employerSocials Float @default(0) // IPRES part patronale, CSS, CFCE

  status String @default("DRAFT") // DRAFT, VALIDATED, PAID

  // Relations
  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  periodId String        @db.ObjectId
  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payslips")
  @@index([cabinetId])
}

// ============================================
// AUDIT — Immobilisations & Dossier de travail
// ============================================

enum FixedAssetStatus {
  FOUND
  MISSING
  TO_VERIFY
  DISPOSED
}

enum DepreciationMethod {
  LINEAIRE
  DEGRESSIF
  NON_AMORTISSABLE
}

model FixedAsset {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  code          String
  label         String
  category      String
  purchaseDate  DateTime
  value         Float
  location      String?
  status        FixedAssetStatus @default(TO_VERIFY)
  lastAuditDate DateTime?

  // Plan d'amortissement — indispensable pour calculer la valeur nette
  // comptable et la dotation de l'exercice. Ces champs manquaient : l'actif
  // etait suivi pour l'inventaire physique, jamais pour sa depreciation.
  depreciationMethod DepreciationMethod @default(LINEAIRE)
  usefulLifeYears    Int? // Duree d'utilite, en annees
  residualValue      Float              @default(0)
  // Date de mise en service, qui peut differer de la date d'acquisition et
  // constitue le point de depart de l'amortissement.
  serviceDate        DateTime?
  serialNumber       String?
  supplier           String?

  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fixed_assets")
  @@index([cabinetId])
}

// Centre de requetes client (justificatifs, signatures, informations
// manquantes) : demandes reellement adressees a un client, suivies jusqu'a
// leur traitement.
model ClientRequest {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type     String // Justificatif manquant | Signature requise | Information manquante
  details  String
  priorite String // Haute | Moyenne | Basse
  statut   String @default("A_ENVOYER") // A_ENVOYER | ENVOYEE | REPONSE_RECUE | TRAITEE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_requests")
  @@index([cabinetId])
}

// Cahier de travail generique (seuil de signification, matrice des risques,
// programme d'audit, circularisations, sondage...) persiste par client et
// par type d'outil. Le contenu varie selon l'outil ; il est stocke tel quel,
// sans reinterpretation, pour eviter de figer un schema different par outil
// alors que la structure exacte de chaque cahier est encore amenee a evoluer.
model WorkPaper {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId String? @db.ObjectId // Tenant owner
  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type String
  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, type])
  @@map("work_papers")
  @@index([cabinetId])
}

