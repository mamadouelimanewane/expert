// Gestion de la qualité du cabinet : risques qualité et constats de revue,
// reliés aux missions quand le sujet porte sur un dossier particulier.
model QualityControl {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId       String?  @db.ObjectId // injecté et filtré par la couche tenant Prisma
  kind            String   // RISK, FINDING, REVIEW
  title           String
  description     String?
  severity        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status          String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, ACCEPTED
  missionId       String?  @db.ObjectId
  ownerId         String?  @db.ObjectId
  reviewFrequencyDays Int?
  lastReviewedAt  DateTime?
  effectivenessResult String? // EFFECTIVE, INEFFECTIVE
  effectivenessEvidence String?
  rootCause       String?
  correctiveAction String?
  dueDate         DateTime?
  resolvedAt      DateTime?
  createdById     String   @db.ObjectId
  reviewedById    String?  @db.ObjectId
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("quality_controls")
  @@index([cabinetId, status, dueDate])
  @@index([cabinetId, missionId])
}

// Avenants et demandes de changement : l'historique approuvé est conservé.
model MissionChangeRequest {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  cabinetId        String?  @db.ObjectId // injecté et filtré par la couche tenant Prisma
  missionId        String   @db.ObjectId
  title            String
  reason           String
  requestedScope   String
  feeDelta         Float    @default(0)
  hoursDelta       Float    @default(0)
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedById    String   @db.ObjectId
  reviewedById     String?  @db.ObjectId
  reviewedAt       DateTime?
  reviewComment    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("mission_change_requests")
  @@index([cabinetId, missionId, status])
  @@index([cabinetId, createdAt])
}

