}

model ApiRequestLog {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  endpoint   String
  method     String
  statusCode Int

  apiKeyId String? @db.ObjectId
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id])

  createdAt DateTime @default(now())

  @@map("api_request_logs")
}

// ============================================
// ESPACES DE COLLABORATION
// ============================================

enum WorkspaceType {
  DUE_DILIGENCE
  LITIGE
  PROJET
  AUTRE
}

enum WorkspaceStatus {
  ACTIF
  ARCHIVE
}

model Workspace {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  type        WorkspaceType   @default(AUTRE)
  status      WorkspaceStatus @default(ACTIF)
  description String?

  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id])

  members    WorkspaceMember[]
  activities WorkspaceActivity[]

  createdById String @db.ObjectId
  createdBy   User   @relation("WorkspaceCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspaces")
}

model WorkspaceMember {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId String    @db.ObjectId
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String @db.ObjectId
  user   User   @relation("WorkspaceMemberships", fields: [userId], references: [id])

  role     String   @default("membre")
  joinedAt DateTime @default(now())

  @@map("workspace_members")
}

model WorkspaceActivity {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId String    @db.ObjectId
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String @db.ObjectId
  user   User   @relation("WorkspaceActivityAuthor", fields: [userId], references: [id])

  action    String
  createdAt DateTime @default(now())

  @@map("workspace_activities")
}

// ============================================
// DETECTION DE FRAUDE
// ============================================

enum FraudAlertSeverity {
  FAIBLE
  MOYENNE
  ELEVEE
  CRITIQUE
}

enum FraudAlertStatus {
  NOUVELLE
  EN_ANALYSE
  CONFIRMEE
  ECARTEE
}

model FraudAlert {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String
  severity      FraudAlertSeverity @default(MOYENNE)
  status        FraudAlertStatus   @default(NOUVELLE)
  amount        Float?
  ruleTriggered String

  clientId String? @db.ObjectId
  client   Client? @relation(fields: [clientId], references: [id])

  transactionId String?          @db.ObjectId
  transaction   BankTransaction? @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fraud_alerts")
}

// ============================================
// RISQUES FISCAUX
// ============================================

enum FiscalRiskLevel {
  FAIBLE
  MOYEN
  ELEVE
}

enum FiscalRiskStatus {
  IDENTIFIE
  EN_TRAITEMENT
  RESOLU
}

model FiscalRisk {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String
  level           FiscalRiskLevel  @default(MOYEN)
  status          FiscalRiskStatus @default(IDENTIFIE)
  potentialImpact Float?

  clientId String @db.ObjectId
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fiscal_risks")
}

// ============================================
// COMMUNAUTE (FORUM)
// ============================================

model ForumPost {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  title   String
  content String
  topic   String
  tags    String[]

  authorId String @db.ObjectId
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments   ForumComment[]
  likedByIds String[]       @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("forum_posts")
}

model ForumComment {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  content String

  postId String    @db.ObjectId
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String @db.ObjectId
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("forum_comments")
}
