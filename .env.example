# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# MongoDB Database URL (voir prisma/schema.prisma — provider = "mongodb")
# Format: mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/cabinet_ohada?retryWrites=true&w=majority"

# JWT Secret utilisé par les vérifications manuelles (ex: /api/health)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# NextAuth — requis par next-auth (session JWT, signature des tokens)
# Générer une valeur forte en prod : openssl rand -base64 32
NEXTAUTH_SECRET="change-this-with-a-strong-random-value-in-production"
NEXTAUTH_URL="http://localhost:3000"

# OCR API Keys (Tesseract, Google Vision, etc.)
GOOGLE_VISION_API_KEY=""
TESSERACT_PATH=""

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@cabinet360.com"

# Synchronisation de la boîte de réception (IMAP) — module Emails
# Gmail nécessite un "mot de passe d'application" (myaccount.google.com/apppasswords),
# le mot de passe normal du compte est refusé par Google pour IMAP.
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASSWORD=""

# File Upload Configuration
MAX_FILE_SIZE="10485760" # 10MB in bytes
UPLOAD_DIR="./uploads"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Stripe/Payment Gateway (for client payments)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# Mobile Money Integration (Wave, Orange Money, MTN)
# Wave for Business : token Bearer du dashboard
WAVE_API_KEY=""

# Orange Money : OAuth client_credentials (Orange Developer Portal) + clé marchande
ORANGE_CONSUMER_KEY=""
ORANGE_CONSUMER_SECRET=""
ORANGE_MERCHANT_KEY=""
ORANGE_MONEY_COUNTRY="sn" # code pays Orange Money (sn, ci, ml, ...)

# MTN MoMo Collection API : Subscription Key + API User/Key (MTN MoMo Developer Portal)
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_ENVIRONMENT="sandbox" # "sandbox" ou "production"
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"

# Webhook WhatsApp (Meta Cloud API) — pas de valeur par défaut en prod :
# si absente, le handshake du webhook échoue volontairement (fail closed).
WHATSAPP_VERIFY_TOKEN=""
# Secret de l'application Meta (Paramètres de l'app > Général > Clé secrète).
# Sert à vérifier la signature x-hub-signature-256 de CHAQUE message entrant.
# Sans lui, les messages entrants sont refusés (503) : le webhook étant exempté
# du contrôle de session, une signature non vérifiée laisserait un inconnu
# injecter des écritures comptables dans le dossier d'un client réel.
WHATSAPP_APP_SECRET=""
# Token système permanent + ID du numéro (Meta Business Suite) — requis pour ENVOYER des messages
# (la réception fonctionne déjà sans, via WHATSAPP_VERIFY_TOKEN uniquement)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# DeepSeek API (Nexus IA — assistant/recherche intelligente)
# Sans cette clé, Nexus IA répond honnêtement qu'il n'est pas configuré au lieu de simuler des réponses.
DEEPSEEK_API_KEY=""

# Lecture par IA des documents manuscrits (balances, cahiers de caisse) —
# Claude (Anthropic). Optionnelle : sans clé, seul l'OCR local (Tesseract)
# est proposé et l'écran d'import l'indique. Le document est transmis à
# l'API Anthropic uniquement sur action explicite de l'utilisateur.
ANTHROPIC_API_KEY=""

# Webhooks de paiement — HMAC-SHA256 partage avec le fournisseur.
# Sans cette valeur, aucun webhook nest accepte (fail closed).
# Specifique par fournisseur : WAVE_WEBHOOK_SECRET, ORANGE_MONEY_WEBHOOK_SECRET,
# MTN_MOMO_WEBHOOK_SECRET ; a defaut PAYMENT_WEBHOOK_SECRET sapplique a tous.
PAYMENT_WEBHOOK_SECRET=""
WAVE_WEBHOOK_SECRET=""
